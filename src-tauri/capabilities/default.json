{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Permissions for the main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:window:allow-set-title",
		"dialog:default",
		"dialog:allow-open",
		"dialog:allow-save",
		"clipboard-manager:allow-read-text"
	]
}
