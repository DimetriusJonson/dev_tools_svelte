{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "WebDev Useful Tools",
	"version": "0.2.0",
	"identifier": "app.webdev.usefultools",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "WebDev Useful Tools",
				"label": "main",
				"width": 1440,
				"height": 920,
				"minWidth": 1100,
				"minHeight": 700,
				"center": true,
				"resizable": true,
				"backgroundColor": "#181818"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"category": "DeveloperTool",
		"shortDescription": "XML, JSON and URL tools for web developers",
		"longDescription": "Format and unescape XML/JSON, encode and decode URLs, and compare text snippets in a fast native desktop app.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3RTlGOUIwRTY4MDNCMTkKUldRWk80RG1zUG5wNTJPOWRTU3FFOE1pNzU5VHRSZWdad2VPUzBoMzF1TDBqRy9GNnp6c0pldWwK",
			"endpoints": [
				"https://github.com/DimetriusJonson/dev_tools_svelte/releases/latest/download/latest.json"
			],
			"requireSignedVersion": true,
			"windows": {
				"installMode": "passive"
			}
		},
		"deep-link": {
			"desktop": {
				"schemes": [
					"webdev-useful-tools"
				]
			}
		}
	}
}
